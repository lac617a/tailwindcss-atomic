---
import {cn} from "../lib/cn";

const base =
	"rounded-full px-4 py-2 text-sm font-medium transition-colors";
const onClass = "bg-emerald-400 text-emerald-950";
const offClass = "bg-zinc-800 text-zinc-400";
---

<button
	id="atomic-chip"
	type="button"
	class={cn(base, onClass)}
	data-on-class={cn(base, onClass)}
	data-off-class={cn(base, offClass)}
>
	cn() · activo
</button>

<script>
	const btn = document.getElementById("atomic-chip");
	if (btn) {
		let on = true;
		btn.addEventListener("click", () => {
			on = !on;
			btn.className = on
				? (btn.dataset.onClass ?? "")
				: (btn.dataset.offClass ?? "");
			btn.textContent = `cn() · ${on ? "activo" : "inactivo"}`;
		});
	}
</script>
