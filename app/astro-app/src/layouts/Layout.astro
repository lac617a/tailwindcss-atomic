---
import "../styles/global.css";

type Props = {
	title?: string;
};

const {title = "Tailwind Atomic · Astro"} = Astro.props;
---

<!doctype html>
<html lang="es" class="h-full">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="min-h-full bg-zinc-950 text-zinc-50 antialiased">
		<slot />
	</body>
</html>
