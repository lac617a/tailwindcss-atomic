{
	"name": "tailwind-atomic-wasm",
	"private": true,
	"scripts": {
		"build": "pnpm build:wasm && pnpm build:js",
		"build:wasm": "wasm-pack build --target nodejs --no-pack --out-dir packages/pkg",
		"build:js": "pnpm --filter tailwindcss-atomic build",
		"dev": "pnpm --filter next-app dev"
	},
	"devDependencies": {
		"@types/node": "^22.20.1",
		"turbo": "^2.10.12",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=22.18.0"
	}
}
