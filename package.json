{
	"name": "tailwind-atomic-wasm",
	"private": true,
	"license": "MIT",
	"scripts": {
		"build": "pnpm build:wasm && pnpm build:js",
		"build:wasm": "wasm-pack build --target nodejs --no-pack --out-dir packages/pkg && node -e \"require('fs').writeFileSync('packages/pkg/package.json', JSON.stringify({type:'commonjs'}))\"",
		"build:js": "pnpm --filter tailwindcss-atomic build",
		"dev": "pnpm --filter next-app dev",
		"dev:vite": "pnpm --filter vite-app dev",
		"dev:vite4": "pnpm --filter vite-v4-app dev",
		"dev:astro": "pnpm --filter astro-app dev",
		"dev:next12": "pnpm --filter next12-app dev",
		"dev:turbo": "pnpm --filter next-turbo-app dev",
		"dev:examples": "turbo run dev --filter=next-app --filter=vite-app --filter=vite-v4-app --filter=next12-app --filter=next-turbo-app --filter=astro-app",
		"test": "pnpm --filter tailwindcss-atomic test",
		"test:coverage": "pnpm --filter tailwindcss-atomic test:coverage",
		"test:rust": "cargo test"
	},
	"devDependencies": {
		"@types/node": "^22.20.1",
		"turbo": "^2.10.12",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=22.18.0"
	}
}
