{
	"name": "tailwindcss-atomic",
	"version": "1.0.14",
	"type": "module",
	"description": "atomic css classes for tailwindcss. support vite, webpack, rollup and next.js!",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"scripts": {
		"dev": "tsdown --watch --sourcemap",
		"build": "tsdown"
	},
	"keywords": [
		"tailwindcss",
		"utilities",
		"atomic",
		"class",
		"obfuscator",
		"obfuscation"
	],
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./next": {
			"import": {
				"types": "./dist/next.d.mts",
				"default": "./dist/next.mjs"
			},
			"require": {
				"types": "./dist/next.d.cts",
				"default": "./dist/next.cjs"
			}
		},
		"./vite": {
			"import": {
				"types": "./dist/vite.d.mts",
				"default": "./dist/vite.mjs"
			},
			"require": {
				"types": "./dist/vite.d.cts",
				"default": "./dist/vite.cjs"
			}
		},
		"./webpack": {
			"import": {
				"types": "./dist/webpack.d.mts",
				"default": "./dist/webpack.mjs"
			},
			"require": {
				"types": "./dist/webpack.d.cts",
				"default": "./dist/webpack.cjs"
			}
		},
		"./rollup": {
			"import": {
				"types": "./dist/rollup.d.mts",
				"default": "./dist/rollup.mjs"
			},
			"require": {
				"types": "./dist/rollup.d.cts",
				"default": "./dist/rollup.cjs"
			}
		},
		"./postcss": {
			"types": "./dist/postcss.d.mts",
			"import": "./dist/postcss.mjs",
			"require": "./postcss.cjs"
		},
		"./*": "./*"
	},
	"files": [
		"pkg",
		"dist",
		"postcss.cjs"
	],
	"dependencies": {
		"@babel/generator": "^7.24.0",
		"@babel/parser": "^7.24.0",
		"@babel/traverse": "^7.24.0",
		"@babel/types": "^7.24.0",
		"postcss": "^8.0.0",
		"unplugin": "^1.10.0"
	},
	"peerDependencies": {
		"postcss": "^8.0.0",
		"webpack": ">=5"
	},
	"peerDependenciesMeta": {
		"webpack": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/babel__generator": "^7.27.0",
		"@types/babel__traverse": "^7.28.0",
		"@types/node": "^22.20.1",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/",
		"main": "./dist/index.cjs",
		"module": "./dist/index.mjs"
	},
	"typesVersions": {
		"*": {
			"*": [
				"./dist/*",
				"./dist/index.d.mts"
			]
		}
	},
	"engines": {
		"node": ">=22.18.0"
	}
}