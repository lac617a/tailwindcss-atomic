{
	"name": "tailwindcss-atomic",
	"version": "1.0.5",
	"license": "MIT",
	"type": "module",
	"author": "lac617a <dominyel.r@gmail.com>",
	"description": "atomic css classes for tailwindcss. support vite, webpack, rollup and next.js!",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"homepage": "https://atomic.profiya.com/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lac617a/tailwindcss-atomic.git",
		"directory": "packages/tailwindcss-atomic"
	},
	"bugs": {
		"url": "https://github.com/lac617a/tailwindcss-atomic/issues"
	},
	"scripts": {
		"dev": "tsdown --watch --sourcemap",
		"build": "tsdown",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"keywords": [
		"tailwindcss",
		"utilities",
		"atomic",
		"class",
		"obfuscator",
		"obfuscation"
	],
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./next": {
			"import": {
				"types": "./dist/next.d.mts",
				"default": "./dist/next.mjs"
			},
			"require": {
				"types": "./dist/next.d.cts",
				"default": "./dist/next.cjs"
			}
		},
		"./vite": {
			"import": {
				"types": "./dist/vite.d.mts",
				"default": "./dist/vite.mjs"
			},
			"require": {
				"types": "./dist/vite.d.cts",
				"default": "./dist/vite.cjs"
			}
		},
		"./webpack": {
			"import": {
				"types": "./dist/webpack.d.mts",
				"default": "./dist/webpack.mjs"
			},
			"require": {
				"types": "./dist/webpack.d.cts",
				"default": "./dist/webpack.cjs"
			}
		},
		"./rollup": {
			"import": {
				"types": "./dist/rollup.d.mts",
				"default": "./dist/rollup.mjs"
			},
			"require": {
				"types": "./dist/rollup.d.cts",
				"default": "./dist/rollup.cjs"
			}
		},
		"./esbuild": {
			"import": {
				"types": "./dist/esbuild.d.mts",
				"default": "./dist/esbuild.mjs"
			},
			"require": {
				"types": "./dist/esbuild.d.cts",
				"default": "./dist/esbuild.cjs"
			}
		},
		"./postcss": {
			"types": "./dist/postcss.d.mts",
			"import": "./dist/postcss.mjs",
			"require": "./postcss.cjs"
		},
		"./*": "./*"
	},
	"files": [
		"pkg",
		"dist",
		"postcss.cjs",
		"README.md"
	],
	"dependencies": {
		"@babel/generator": "^7.24.0",
		"@babel/parser": "^7.24.0",
		"@babel/traverse": "^7.24.0",
		"@babel/types": "^7.24.0",
		"postcss": "^8.0.0",
		"unplugin": "^1.10.0"
	},
	"peerDependencies": {
		"postcss": "^8.0.0",
		"sass": ">=1.60",
		"webpack": ">=5"
	},
	"peerDependenciesMeta": {
		"sass": {
			"optional": true
		},
		"webpack": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/babel__generator": "^7.27.0",
		"@types/babel__traverse": "^7.28.0",
		"@types/node": "^22.20.1",
		"@vitest/coverage-v8": "^4.1.11",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/",
		"main": "./dist/index.cjs",
		"module": "./dist/index.mjs"
	},
	"typesVersions": {
		"*": {
			"*": [
				"./dist/*",
				"./dist/index.d.mts"
			]
		}
	},
	"engines": {
		"node": ">=22.18.0"
	}
}